{
  "name": "forkspace",
  "version": "0.29.0",
  "description": "A canvas control center for Claude Code agents: branch any conversation, run many agents, keep notes.",
  "homepage": "https://forkspace-app.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikhils4/forkspace.git"
  },
  "bugs": {
    "url": "https://github.com/nikhils4/forkspace/issues"
  },
  "author": "nikhils4 (https://github.com/nikhils4)",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"node --watch server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "npm run build && node build/server/index.js",
    "typecheck": "tsc",
    "prepublishOnly": "npm run build",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-agent-sdk",
    "anthropic",
    "ai-agents",
    "coding-agent",
    "ai-coding",
    "agent",
    "editor",
    "ide",
    "canvas",
    "branching",
    "git-worktree",
    "diff",
    "developer-tools",
    "pwa",
    "self-hosted"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "nanoid": "^6.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^12.12.1",
    "concurrently": "^10.0.7",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "bin": {
    "forkspace": "bin/forkspace.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "build",
    "dist"
  ],
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
